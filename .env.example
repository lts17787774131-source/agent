# ============================================
# 大模型配置（二选一，注释掉不用的那个）
# ============================================

# ---------- 方案 A：Ollama 本地模型（免费，无需 Key） ----------
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=dummy
LLM_MODEL=qwen3:4b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_STREAMING=true
OLLAMA_THINK=false

# ---------- 方案 B：DeepSeek 云端 API（性能更好，需 Key） ----------
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-你的密钥
# LLM_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=1024
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=2
# LLM_STREAMING=true

# ---------- 方案 C：OpenAI 官方 API ----------
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-你的密钥
# LLM_MODEL=gpt-3.5-turbo
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=1024

# ============================================
# Agent 运行配置
# ============================================
AGENT_MAX_STEPS=6
AGENT_MAX_CONTEXT_CHARS=3000
AGENT_REFLECTION_ENABLED=true

# ============================================
# 工具安全配置
# ============================================
TOOL_SAFE_DIRS=data,output,uploads
TOOL_MAX_FILE_CHARS=3000
TOOL_DEFAULT_MAX_LINES=200

# ============================================
# 日志配置
# ============================================
LOG_DIR=logs
LOG_CHAT_HISTORY=true
LOG_LEVEL=INFO
